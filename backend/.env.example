# Required
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
TAVILY_API_KEY=tvly-your-tavily-key
FIRECRAWL_API_KEY=fc-your-firecrawl-key

# Optional
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEMO_MODE=live

# Model routing (optional — sensible defaults are built in)
# Every model is overridable, so the pipeline can run entirely on one provider
# if the other is down or out of credits. Verified working on Gemini alone.
# PRIMARY_MODEL=openai/gpt-4o                    # agent synthesis calls
# FALLBACK_MODEL=gemini/gemini-3.6-flash         # automatic failover for the above
# MINI_MODEL=openai/gpt-4o-mini                  # cheap utility calls
# MINI_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite
# AEO probes two engines and compares recall. Not routed on purpose: a fallback
# would attribute one engine's answer to the other. A probe that cannot reach
# its provider is currently scored as "not mentioned", understating the result.
# AEO_FIRST_MODEL=openai/gpt-4o
# AEO_SECOND_MODEL=gemini/gemini-3.6-flash

# CORS: comma-separated origins. Defaults to localhost:5173-5199 for dev.
# Any real deployment must set this or the browser will be blocked.
# CORS_ORIGINS=https://yourdomain.com

# Image generation model (OpenAI-only capability; dall-e-3 has been retired)
# IMAGE_MODEL=gpt-image-1
