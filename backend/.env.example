# Blitz backend configuration.
# Copy to .env and fill in the keys. Every value below is optional except the
# provider keys — the defaults in config.py are what run if you omit them.

# ----------------------------------------------------------------------
# Required — provider credentials
# ----------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# ----------------------------------------------------------------------
# Optional — voice agent
# ----------------------------------------------------------------------
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# ELEVENLABS_TIMEOUT_SECONDS=30.0

# ----------------------------------------------------------------------
# Model routing — set these to run entirely on one provider
# ----------------------------------------------------------------------
# PRIMARY_MODEL=openai/gpt-4o
# FALLBACK_MODEL=gemini/gemini-3.6-flash
# MINI_MODEL=openai/gpt-4o-mini
# MINI_FALLBACK_MODEL=gemini/gemini-3.5-flash-lite

# ----------------------------------------------------------------------
# AEO probes (deliberately unrouted: two engines are compared)
# ----------------------------------------------------------------------
# AEO_FIRST_MODEL=openai/gpt-4o
# AEO_SECOND_MODEL=gemini/gemini-3.6-flash

# ----------------------------------------------------------------------
# LLM reliability
# ----------------------------------------------------------------------
# REQUEST_TIMEOUT_SECONDS=90.0
# LLM_NUM_RETRIES=2
# RATE_LIMIT_RETRIES=3
# TIMEOUT_RETRIES=2
# SERVER_ERROR_RETRIES=2
# ROUTER_ALLOWED_FAILS=3
# ROUTER_COOLDOWN_SECONDS=30

# ----------------------------------------------------------------------
# Agent sampling
# ----------------------------------------------------------------------
# RESEARCH_TEMPERATURE=0.4
# PROFILE_TEMPERATURE=0.3
# AUDIENCE_TEMPERATURE=0.4
# CONTENT_TEMPERATURE=0.4
# SALES_TEMPERATURE=0.4
# ADS_TEMPERATURE=0.5
# IMAGE_PROMPT_TEMPERATURE=0.8
# CRITIC_TEMPERATURE=0.0
# CONTENT_MAX_TOKENS=16000

# ----------------------------------------------------------------------
# Agent 0 research
# ----------------------------------------------------------------------
# SEARCH_TIMEOUT_SECONDS=25.0
# SCRAPE_TIMEOUT_SECONDS=25.0
# AEO_QUERY_TIMEOUT_SECONDS=60.0
# QUICK_EXTRACT_TIMEOUT_SECONDS=10.0
# PRESS_RESULTS_PER_SEARCH=5
# COMPETITOR_RESULTS_PER_SEARCH=8
# MAX_PRESS_ITEMS=10

# ----------------------------------------------------------------------
# Prompt context trimming
# ----------------------------------------------------------------------
# SITE_CONTENT_PROMPT_CHARS=1500

# ----------------------------------------------------------------------
# Image generation (OpenAI-only capability)
# ----------------------------------------------------------------------
# IMAGE_MODEL=gpt-image-1
# IMAGE_SIZE=1024x1024
# IMAGE_TIMEOUT_SECONDS=120.0
# IMAGE_CAP_PER_RUN=3

# ----------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------
# CHROMA_PATH=./chroma_data
# CHROMA_COLLECTION=blitz_pipeline
# CHROMA_IN_MEMORY=False
# CHROMA_DISABLE_EMBEDDINGS=False
# SQLITE_PATH=./blitz.db

# ----------------------------------------------------------------------
# HTTP / CORS — must be set for any real deployment
# ----------------------------------------------------------------------
# CORS_ORIGINS=
# DEV_CORS_PORT_START=5173
# DEV_CORS_PORT_END=5200

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
# LOG_LEVEL=INFO
